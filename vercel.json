{
  "rewrites": [
    {
      "source": "/coffee",
      "destination": "/coffee.html"
    },
    {
      "source": "/coffee/s/:key",
      "destination": "/coffee-marka.html"
    },
    {
      "source": "/coffee/:slug",
      "destination": "/coffee-marka.html"
    }
  ],
  "redirects": [
    {
      "source": "/radyo.html",
      "has": [
        {
          "type": "query",
          "key": "key",
          "value": "(?<key>.*)"
        }
      ],
      "destination": "/coffee/s/:key",
      "permanent": true
    },
    {
      "source": "/radyo.html",
      "destination": "/coffee",
      "permanent": true
    }
  ],
  "functions": {
    "api/sarki-referans.js": {
      "maxDuration": 30
    },
    "api/dekont-tara.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,@tesseract.js-data/tur/4.0.0_best_int}/**"
    }
  }
}
